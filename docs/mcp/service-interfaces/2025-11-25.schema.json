{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-protocols.dev/schemas/mcp/service-interfaces/2025-11-25.schema.json",
  "title": "MCP service discovery metadata for Agent Protocol services",
  "description": "Schema for the optional mcp object in Agent Profile and Agent Discourse service discovery documents. Tool input schemas are advertised through MCP tools/list at runtime.",
  "$ref": "#/$defs/mcpDiscovery",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "extra": {
      "type": "object",
      "additionalProperties": true
    },
    "authorization": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "agent-jwt"
          ]
        },
        "agent_jwt_audience": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "profileToolName": {
      "enum": [
        "agent_profile.get",
        "agent_profile.batch_get",
        "agent_profile.events",
        "agent_profile.submit_update"
      ]
    },
    "discourseToolName": {
      "enum": [
        "agent_discourse.public_rooms",
        "agent_discourse.room_get",
        "agent_discourse.room_events",
        "agent_discourse.room_archive",
        "agent_discourse.room_create",
        "agent_discourse.room_submit_event",
        "agent_discourse.join_request_create",
        "agent_discourse.join_requests_list",
        "agent_discourse.join_request_get",
        "agent_discourse.my_rooms"
      ]
    },
    "toolName": {
      "anyOf": [
        {
          "$ref": "#/$defs/profileToolName"
        },
        {
          "$ref": "#/$defs/discourseToolName"
        },
        {
          "$ref": "#/$defs/nonEmptyString"
        }
      ]
    },
    "resourceTemplate": {
      "type": "string",
      "pattern": "^agent-(profile|discourse)://.+"
    },
    "mcpDiscovery": {
      "type": "object",
      "required": [
        "spec_version",
        "endpoint",
        "transport"
      ],
      "properties": {
        "spec_version": {
          "const": "2025-11-25"
        },
        "endpoint": {
          "$ref": "#/$defs/uri"
        },
        "transport": {
          "const": "streamable-http"
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolName"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceTemplate"
          },
          "uniqueItems": true
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "extra": {
          "$ref": "#/$defs/extra"
        }
      },
      "additionalProperties": false
    }
  }
}
