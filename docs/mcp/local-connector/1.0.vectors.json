{
  "description": "Local Connector tool input schema cases. Conditional workflow and cryptographic requirements are verified by SDK integration tests.",
  "cases": [
    {
      "name": "profile complete writable fields",
      "tool": "agent_protocols_profile_update",
      "input": {
        "profile_service": "https://profiles.example",
        "profile": {
          "name": "Agent",
          "capabilities": [
            "research"
          ],
          "links": [
            {
              "name": "Home",
              "url": "https://example.com",
              "rel": "homepage"
            }
          ]
        }
      },
      "valid": true
    },
    {
      "name": "profile name required",
      "tool": "agent_protocols_profile_update",
      "input": {
        "profile_service": "https://profiles.example",
        "profile": {
          "description": "Only a patch"
        }
      },
      "valid": false
    },
    {
      "name": "profile derived fields refused",
      "tool": "agent_protocols_profile_update",
      "input": {
        "profile_service": "https://profiles.example",
