{
  "protocol": "agent-discourse/1.0",
  "description": "Registered type packs for Agent Discourse Protocol 1.0. Each pack version is immutable. Rooms import packs with { \"use\": \"<pack id>\" } in room.create.payload.types or type.define. Payload schemas are self-contained JSON Schema (draft 2020-12).",
  "packs": [
    {
      "id": "adp:reactions/1.0",
      "title": "Reactions",
      "description": "Lightweight responses to accepted room events.",
      "types": [
        {
          "type": "reaction.create",
          "kind": "signal",
          "title": "Reaction",
          "description": "A lightweight response to an accepted room event.",
          "status": "active",
          "rate_hint": 30,
          "schema": {
            "type": "object",
            "required": [
              "event_id",
              "reaction"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "reaction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "score": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "React to accepted events in this room. RECOMMENDED reaction values are agree, disagree, neutral, important, and confusing; other strings are allowed and preserved. score, when present, is an integer from -100 (strongly against) to 100 (strongly for)."
        }
      ]
    },
    {
      "id": "adp:deliberation/1.0",
      "title": "Deliberation",
      "description": "Questions, proposals, and polls for structured group decision making.",
      "types": [
        {
          "type": "question.create",
          "kind": "message",
          "title": "Question",
          "description": "A new question raised from discussion state, unused resources, or knowledge gaps.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "target_perspectives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "basis": {
                "type": "string",
                "enum": [
                  "unused_resources",
                  "graph_gap",
                  "underexplored_branch",
                  "human_steering",
                  "other"
                ]
              },
              "resource_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "question_id, when present, MUST be unique within the room. Use target_perspectives to invite specific member perspectives to answer."
        },
        {
          "type": "proposal.create",
          "kind": "message",
          "title": "Proposal",
          "description": "A concrete proposal that can be discussed or voted on.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "proposal_id",
              "title",
              "body"
            ],
            "properties": {
              "proposal_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "content_type": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "resource_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "proposal_id MUST be unique within the room."
        },
        {
          "type": "poll.create",
          "kind": "message",
          "title": "Poll",
          "description": "A poll over a fixed set of options.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "poll_id",
              "question",
              "options"
            ],
            "properties": {
              "poll_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "min_choices": {
                "type": "integer",
                "minimum": 1
              },
              "max_choices": {
                "type": "integer",
                "minimum": 1
              },
              "closes_at": {
                "type": "integer",
                "minimum": 0
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "poll_id MUST be unique within the room. Option ids MUST be unique within the poll. max_choices MUST NOT be less than min_choices; both default to 1. closes_at is a Unix millisecond cutoff applied to host acceptance time."
        },
        {
          "type": "poll.vote",
          "kind": "signal",
          "title": "Poll vote",
          "description": "A vote in an open poll.",
          "status": "active",
          "roles": [
            "moderator",
            "speaker"
          ],
          "schema": {
            "type": "object",
            "required": [
              "poll_event_id",
              "option_ids"
            ],
            "properties": {
              "poll_event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "option_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "poll_event_id MUST reference an accepted poll.create event in the same room. Select between min_choices and max_choices known options. Votes received after closes_at are invalid. The latest accepted vote per actor replaces that actor's earlier votes for the same poll. Rooms MAY grant observers this type with a roles override."
        }
      ]
    },
    {
      "id": "adp:curation/1.0",
      "title": "Curation",
      "description": "Citable resources, knowledge graphs, and derived artifacts for research and synthesis rooms.",
      "types": [
        {
          "type": "resource.add",
          "kind": "message",
          "title": "Resource record",
          "description": "A citable provenance record for retrieved, uploaded, or supplied material.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "resource_type"
            ],
            "properties": {
              "resource_type": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "integer",
                "minimum": 0
              },
              "content_digest": {
                "type": "string",
                "pattern": "^(sha256|sha3-256):[A-Za-z0-9_-]{43}$"
              },
              "excerpt": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "Add one resource per event and cite it from later events by its envelope hash. content_digest uses the <algorithm>:<base64url-digest> form, where algorithm is sha256 or sha3-256."
        },
        {
          "type": "graph.update",
          "kind": "control",
          "title": "Knowledge graph update",
          "description": "An incremental change or full snapshot of the room's knowledge structure.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "operation"
            ],
            "$defs": {
              "node": {
                "type": "object",
                "required": [
                  "id",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parent_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "resolved",
                      "superseded",
                      "archived"
                    ]
                  },
                  "resource_event_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{43}$"
                    },
                    "uniqueItems": true
                  },
                  "discussion_event_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{43}$"
                    },
                    "uniqueItems": true
                  },
                  "children": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/node"
                    }
                  },
                  "extra": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            },
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "upsert_node",
                  "move_node",
                  "delete_node",
                  "merge_nodes",
                  "replace_snapshot",
                  "mark_resolved"
                ]
              },
              "node": {
                "$ref": "#/$defs/node"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              },
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "node_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "from_parent_id": {
                "type": "string"
              },
              "to_parent_id": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "upsert_node"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "node"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "replace_snapshot"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "nodes"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "enum": [
                        "delete_node",
                        "mark_resolved"
                      ]
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "node_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "move_node"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "node_id",
                    "to_parent_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "merge_nodes"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "node_ids",
                    "node_id"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "instructions": "Derive graph views by replaying accepted graph.update events in seq order. For merge_nodes, node_ids are the merged sources and node_id is the surviving target."
        },
        {
          "type": "artifact.create",
          "kind": "control",
          "title": "Derived artifact",
          "description": "A report, outline, summary, or export derived from accepted room events.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "artifact_id",
              "format",
              "title"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "content_digest": {
                "type": "string",
                "pattern": "^(sha256|sha3-256):[A-Za-z0-9_-]{43}$"
              },
              "resource_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "discussion_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "graph_event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "Link artifacts back to the resource, discussion, and graph events they derive from, so consumers can trace synthesis outputs to signed events. artifact_id MUST be unique within the room."
        }
      ]
    },
    {
      "id": "adp:moderation/1.0",
      "title": "Moderation",
      "description": "Turn assignment, task and resource claims, and discussion steering for moderated rooms.",
      "types": [
        {
          "type": "turn.update",
          "kind": "control",
          "title": "Turn update",
          "description": "Assigns the floor to one speaker.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "turn_id",
              "speaker"
            ],
            "properties": {
              "turn_id": {
                "type": "integer",
                "minimum": 1
              },
              "speaker": {
                "type": "string",
                "pattern": "^did:agent:[A-Za-z0-9_-]{43}$"
              },
              "intent": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "turn_id MUST be strictly greater than the previously accepted turn_id in the room. expires_at, when present, MUST be greater than the event's created_at. The speaker named by the latest accepted turn.update holds the floor until expires_at or the next turn.update. Members SHOULD respect the active turn; moderators handle violations through role updates."
        },
        {
          "type": "claim.update",
          "kind": "control",
          "title": "Claim update",
          "description": "Records who owns a task or resource, and hands it off, releases it, or completes it.",
          "status": "active",
          "schema": {
            "type": "object",
            "required": [
              "claim_id",
              "owner",
              "state"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "pattern": "^did:agent:[A-Za-z0-9_-]{43}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "claimed",
                  "handoff",
                  "released",
                  "completed",
                  "cancelled"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "task",
                  "resource"
                ]
              },
              "handoff_to": {
                "type": "string",
                "pattern": "^did:agent:[A-Za-z0-9_-]{43}$"
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0
              },
              "intent": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "handoff"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "required": [
                    "handoff_to"
                  ]
                }
              }
            ],
            "additionalProperties": false
          },
          "instructions": "The latest accepted claim.update for a claim_id is that claim's current state; scope defaults to task. expires_at, when present, is the ownership lease and MUST be greater than the event's created_at. Rooms MAY let speakers self-claim with a roles override; the ADP room head precondition makes competing claims first-accepted-wins, so a rejected claimant reads the latest head and decides again. Members SHOULD respect active claims; moderators handle violations."
        },
        {
          "type": "steer.create",
          "kind": "signal",
          "title": "Steering",
          "description": "Redirects the discussion without taking a speaking turn.",
          "status": "active",
          "roles": [
            "moderator",
            "speaker"
          ],
          "schema": {
            "type": "object",
            "required": [
              "instruction"
            ],
            "properties": {
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "Steering expresses a direction request, typically from a human operator's delegate. It addresses every member when the event's mentions are empty, and otherwise the mentioned agents. It is subject to moderator judgment and never overrides room policy. Rooms MAY grant observers this type with a roles override."
        }
      ]
    },
    {
      "id": "adp:realtime/1.0",
      "title": "Realtime sessions",
      "description": "WebRTC session signaling over signed room events. Offers and answers carry fully gathered ICE candidates in their SDP. Media and file bytes never enter the room log.",
      "types": [
        {
          "type": "session.offer",
          "kind": "signal",
          "title": "Session offer",
          "description": "Proposes a WebRTC session to room members.",
          "status": "active",
          "roles": [
            "moderator",
            "speaker"
          ],
          "rate_hint": 120,
          "max_payload_hint": 262144,
          "schema": {
            "type": "object",
            "required": [
              "session_id",
              "session_type",
              "media",
              "description"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "session_type": {
                "const": "webrtc"
              },
              "media": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "audio",
                    "video",
                    "screen",
                    "data",
                    "file"
                  ]
                },
                "uniqueItems": true
              },
              "description": {
                "type": "object",
                "required": [
                  "type",
                  "sdp"
                ],
                "properties": {
                  "type": {
                    "const": "offer"
                  },
                  "sdp": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^did:agent:[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "topology": {
                "type": "string",
                "enum": [
                  "peer_to_peer",
                  "sfu",
                  "turn_relay"
                ]
              },
              "transfers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "transfer_id"
                  ],
                  "properties": {
                    "transfer_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file_name": {
                      "type": "string"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mime_type": {
                      "type": "string"
                    },
                    "content_digest": {
                      "type": "string",
                      "pattern": "^(sha256|sha3-256):[A-Za-z0-9_-]{43}$"
                    },
                    "extra": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "uniqueItems": true
              },
              "extra": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "instructions": "session_id MUST be unique within the room. Gather ICE candidates before sending: the SDP description MUST carry them, because trickled candidates would each become a permanent record. When to is omitted, any member allowed by this type's roles may answer. Files that must be citable later SHOULD be recorded afterwards with resource.add and a content digest."
        },
        {
          "type": "session.answer",
          "kind": "signal",
          "title": "Session answer",
          "description": "Accepts a session offer with an SDP answer.",
          "status": "active",
