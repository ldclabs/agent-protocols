{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-protocols.dev/schemas/agent-profile/1.0.schema.json",
  "title": "Agent Profile Protocol 1.0",
  "description": "JSON Schema definitions for Agent Profile 1.0: the profile.update envelope, the materialized profile document, and the HTTP API bodies. Service limits and the materialization rules remain normative in the specification.",
  "$ref": "#/$defs/profileUpdateEnvelope",
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^did:agent:[A-Za-z0-9_-]{43}$"
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "httpsOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@\\s]+$"
    },
    "extra": {
      "type": "object",
      "additionalProperties": true
    },
    "serviceEndpoint": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "protocols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "name",
        "url",
        "rel"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "rel": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "principalDescriptor": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/httpsUrl"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "delegationHint": {
      "type": "object",
      "required": [
        "principal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "principal": {
          "$ref": "#/$defs/principalDescriptor"
        },
        "relationship": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "profileUpdatePayload": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/agentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "avatar_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "provider": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "service_endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceEndpoint"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "delegations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delegationHint"
          }
        },
        "extra": {
          "$ref": "#/$defs/extra"
        }
      },
      "additionalProperties": true
    },
    "profileUpdateEvent": {
      "type": "object",
      "required": [
        "protocol",
        "type",
        "actor",
        "created_at",
        "nonce",
        "payload"
      ],
      "properties": {
        "protocol": {
          "const": "agent-profile/1.0"
        },
        "type": {
          "const": "profile.update"
        },
        "actor": {
          "$ref": "#/$defs/agentId"
        },
        "created_at": {
          "$ref": "#/$defs/timestampMs"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "payload": {
          "$ref": "#/$defs/profileUpdatePayload"
        }
      },
      "additionalProperties": false
    },
    "profileUpdateEnvelope": {
      "type": "object",
      "required": [
        "hash",
        "event",
        "signature"
      ],
      "properties": {
        "hash": {
          "$ref": "#/$defs/eventHash"
        },
        "event": {
          "$ref": "#/$defs/profileUpdateEvent"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "additionalProperties": false
    },
    "profileDocument": {
      "type": "object",
      "required": [
        "id",
        "name",
        "updated_at",
        "event_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/agentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "avatar_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "provider": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "service_endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceEndpoint"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "delegations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delegationHint"
          }
        },
        "extra": {
          "$ref": "#/$defs/extra"
        },
        "updated_at": {
          "$ref": "#/$defs/timestampMs"
        },
        "event_id": {
          "$ref": "#/$defs/eventHash"
        }
      },
      "additionalProperties": false
    },
    "profileBatchRequest": {
      "type": "object",
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentId"
          },
          "maxItems": 1000
        }
      },
      "additionalProperties": false
    },
    "profileBatchResponse": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileDocument"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "profileEventsResponse": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileUpdateEnvelope"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "discoveryDocument": {
      "type": "object",
      "required": [
        "protocol",
        "service"
      ],
      "properties": {
        "protocol": {
          "const": "agent-profile/1.0"
        },
        "service": {
          "$ref": "#/$defs/httpsOrigin"
        },
        "endpoints": {
          "type": "object",
          "properties": {
            "profiles": {
              "$ref": "#/$defs/httpsUrl"
            },
            "profile_batch": {
              "$ref": "#/$defs/httpsUrl"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/httpsUrl"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  }
}
