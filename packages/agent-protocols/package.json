{
  "name": "agent-protocols",
  "version": "0.10.1",
  "description": "TypeScript SDK for Agent Identity, Agent Profile, Agent Delegation, Agent Discourse, and Agent Knowledge protocols",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldclabs/agent-protocols.git",
    "directory": "packages/agent-protocols"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./delegation": {
      "types": "./dist/delegation.d.ts",
      "import": "./dist/delegation.js"
    },
    "./discourse": {
      "types": "./dist/discourse.d.ts",
      "import": "./dist/discourse.js"
    },
    "./http-client": {
      "types": "./dist/http-client.d.ts",
      "import": "./dist/http-client.js"
    },
    "./local-connector": {
      "types": "./dist/local-connector.d.ts",
      "import": "./dist/local-connector.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@noble/hashes": "^2.4.0",
    "canonicalize": "^4.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}